---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { loadSite } from '../lib/site.mjs';

const { project, gallery } = await loadSite();
// Gallery originals live in public/ (the 3D explorer loads them by URL); the build makes small WebP copies for the strip.
const originals = import.meta.glob<{ default: ImageMetadata }>('/public/media/gallery/*.jpg', { eager: true });
const aerial = originals['/public/media/gallery/aerial_01.jpg'].default;
const strip = gallery.items.slice(0, 4).map((item) => ({ ...item, src: originals[`/public/${item.image}`]?.default }));
---
<Base
  title={`${project.name} · Project`}
  description="AKSA Residence, Montijo: two courtyard blocks, 320 homes from T1 to T3. Key facts, features and every unit with its availability."
  image="media/gallery/aerial_01.jpg"
>
<link rel="stylesheet" href="site.css" slot="head">
<header class="top" id="top">
  <a class="brand" href="index.html">AKSA</a>
  <nav><a class="btn ghost hide-m" href="index.html">Explore in 3D</a><a class="btn primary" id="top-call" href="#contact">Request a call</a></nav>
</header>

<div class="hero">
  <Image id="hero-img" src={aerial} widths={[640, 1024, aerial.width]} sizes="100vw" loading="eager" fetchpriority="high" alt="Aerial view of both residential blocks, the boulevard and open fields" />
  <div class="wrap">
    <p class="eyebrow" id="hero-place">Montijo · Lisbon</p>
    <h1 id="hero-title">AKSA Residence</h1>
    <p class="sub" id="hero-sub"></p>
    <div class="cta"><a class="btn primary" href="#units">See available homes</a><a class="btn ghost" href="index.html">Explore in 3D</a></div>
  </div>
</div>

<div class="wrap main">
  <div>
    <section id="info">
      <p class="eyebrow">Information</p>
      <h2>The project</h2>
      <p class="about" id="about"></p>
      <div class="facts" id="facts"></div>
      <div class="strip" id="strip">{strip.map((item) => <a href="index.html#gallery" aria-label={item.caption}>{item.src ? <Image src={item.src} widths={[400, 800]} sizes="(max-width:760px) 50vw, 25vw" alt={item.caption} /> : <img src={item.thumb} alt={item.caption} loading="lazy" />}</a>)}</div>
    </section>
    <section id="features">
      <p class="eyebrow">Features</p>
      <h2>Life at AKSA</h2>
      <ul class="feat" id="feat"></ul>
    </section>
    <section id="units">
      <div class="uh"><div><p class="eyebrow">Units</p><h2>Every home</h2></div>
        <div class="seg" id="by" role="group" aria-label="Group units"><button data-by="type" aria-pressed="true">By typology</button><button data-by="floor" aria-pressed="false">By floor</button></div></div>
      <div class="bar"><span class="count" id="count"></span><div class="chips" id="lot" role="group" aria-label="Block"></div><label class="check"><input type="checkbox" id="avail">Show only available units</label></div>
      <div id="list"></div>
    </section>
  </div>
  <aside class="contact" id="contact">
    <h3>Want to know more?</h3>
    <p>Our sales team answers on WhatsApp. Tell us which home you like and we'll call you back.</p>
    <div id="contact-cta"></div>
    <a class="btn ghost" href="index.html">Explore in 3D</a>
  </aside>
</div>
<p class="credits">Areas, parking and status from the sales inventory. Prices on request. Plans and renders are indicative; final finishes and landscaping may differ.</p>

<script is:inline>
const $=s=>document.querySelector(s);
const fmtInt=n=>Math.round(n).toLocaleString('en-US');
const ST={available:{label:'Available',hex:'#2E9E4F'},reserved:{label:'Reserved',hex:'#E39B17'},soon:{label:'Coming soon',hex:'#4A5B6E'},sold:{label:'Sold',hex:'#C8463D'}};
// icons: Lucide v0.563.0 (ISC, lucide.dev), inlined from the icon set's own node data
const LU={"bed-double": "<path d=\"M2 20v-8a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v8\"/><path d=\"M4 10V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v4\"/><path d=\"M12 4v6\"/><path d=\"M2 18h20\"/>", "car": "<path d=\"M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2\"/><circle cx=\"7\" cy=\"17\" r=\"2\"/><path d=\"M9 17h6\"/><circle cx=\"17\" cy=\"17\" r=\"2\"/>", "ruler-dimension-line": "<path d=\"M10 15v-3\"/><path d=\"M14 15v-3\"/><path d=\"M18 15v-3\"/><path d=\"M2 8V4\"/><path d=\"M22 6H2\"/><path d=\"M22 8V4\"/><path d=\"M6 15v-3\"/><rect x=\"2\" y=\"12\" width=\"20\" height=\"8\" rx=\"2\"/>", "trees": "<path d=\"M10 10v.2A3 3 0 0 1 8.9 16H5a3 3 0 0 1-1-5.8V10a3 3 0 0 1 6 0Z\"/><path d=\"M7 16v6\"/><path d=\"M13 19v3\"/><path d=\"M12 19h8.3a1 1 0 0 0 .7-1.7L18 14h.3a1 1 0 0 0 .7-1.7L16 9h.2a1 1 0 0 0 .8-1.7L13 3l-1.4 1.5\"/>", "house": "<path d=\"M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8\"/><path d=\"M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/>", "arrow-right": "<path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/>", "waves": "<path d=\"M2 6c.6.5 1.2 1 2.5 1C7 7 7 5 9.5 5c2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1\"/><path d=\"M2 12c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1\"/><path d=\"M2 18c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1\"/>", "fence": "<path d=\"M4 3 2 5v15c0 .6.4 1 1 1h2c.6 0 1-.4 1-1V5Z\"/><path d=\"M6 8h4\"/><path d=\"M6 18h4\"/><path d=\"m12 3-2 2v15c0 .6.4 1 1 1h2c.6 0 1-.4 1-1V5Z\"/><path d=\"M14 8h4\"/><path d=\"M14 18h4\"/><path d=\"m20 3-2 2v15c0 .6.4 1 1 1h2c.6 0 1-.4 1-1V5Z\"/>", "ferris-wheel": "<circle cx=\"12\" cy=\"12\" r=\"2\"/><path d=\"M12 2v4\"/><path d=\"m6.8 15-3.5 2\"/><path d=\"m20.7 7-3.5 2\"/><path d=\"M6.8 9 3.3 7\"/><path d=\"m20.7 17-3.5-2\"/><path d=\"m9 22 3-8 3 8\"/><path d=\"M8 22h8\"/><path d=\"M18 18.7a9 9 0 1 0-12 0\"/>", "flower-2": "<path d=\"M12 5a3 3 0 1 1 3 3m-3-3a3 3 0 1 0-3 3m3-3v1M9 8a3 3 0 1 0 3 3M9 8h1m5 0a3 3 0 1 1-3 3m3-3h-1m-2 3v-1\"/><circle cx=\"12\" cy=\"8\" r=\"2\"/><path d=\"M12 10v12\"/><path d=\"M12 22c4.2 0 7-1.667 7-5-4.2 0-7 1.667-7 5Z\"/><path d=\"M12 22c-4.2 0-7-1.667-7-5 4.2 0 7 1.667 7 5Z\"/>", "sprout": "<path d=\"M14 9.536V7a4 4 0 0 1 4-4h1.5a.5.5 0 0 1 .5.5V5a4 4 0 0 1-4 4 4 4 0 0 0-4 4c0 2 1 3 1 5a5 5 0 0 1-1 3\"/><path d=\"M4 9a5 5 0 0 1 8 4 5 5 0 0 1-8-4\"/><path d=\"M5 21h14\"/>", "sun": "<circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 2v2\"/><path d=\"M12 20v2\"/><path d=\"m4.93 4.93 1.41 1.41\"/><path d=\"m17.66 17.66 1.41 1.41\"/><path d=\"M2 12h2\"/><path d=\"M20 12h2\"/><path d=\"m6.34 17.66-1.41 1.41\"/><path d=\"m19.07 4.93-1.41 1.41\"/>", "building-2": "<path d=\"M10 12h4\"/><path d=\"M10 8h4\"/><path d=\"M14 21v-3a2 2 0 0 0-4 0v3\"/><path d=\"M6 10H4a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2\"/><path d=\"M6 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16\"/>", "square-parking": "<rect width=\"18\" height=\"18\" x=\"3\" y=\"3\" rx=\"2\"/><path d=\"M9 17V7h4a3 3 0 0 1 0 6H9\"/>", "bike": "<circle cx=\"18.5\" cy=\"17.5\" r=\"3.5\"/><circle cx=\"5.5\" cy=\"17.5\" r=\"3.5\"/><circle cx=\"15\" cy=\"5\" r=\"1\"/><path d=\"M12 17.5V14l-3-3 4-3 2 3h2\"/>", "store": "<path d=\"M15 21v-5a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v5\"/><path d=\"M17.774 10.31a1.12 1.12 0 0 0-1.549 0 2.5 2.5 0 0 1-3.451 0 1.12 1.12 0 0 0-1.548 0 2.5 2.5 0 0 1-3.452 0 1.12 1.12 0 0 0-1.549 0 2.5 2.5 0 0 1-3.77-3.248l2.889-4.184A2 2 0 0 1 7 2h10a2 2 0 0 1 1.653.873l2.895 4.192a2.5 2.5 0 0 1-3.774 3.244\"/><path d=\"M4 10.95V19a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8.05\"/>"};
const lu=(n,cls='')=>`<svg class="lu ${cls}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${LU[n]}</svg>`;
const FEAT_ICON={pool:'waves',pergola:'fence',play:'ferris-wheel',gardens:'flower-2',private:'sprout',terraces:'sun',balconies:'building-2',parking:'square-parking',boulevard:'trees',cycle:'bike',commercial:'store'};
const icon=id=>lu(FEAT_ICON[id]||'house');
const GO=lu('arrow-right');
const home=u=>`homes/${String((u.inv||{}).code||u.id).toLowerCase()}.html`;
const hico=id=>lu({bed:'bed-double',car:'car',area:'ruler-dimension-line',tree:'trees',plan:'house'}[id]);
const PJ={by:'type',only:false,block:''};
const blockOf=u=>(u.inv||{}).block||'';
// homes not released yet (CRM "Not released") stay off this page, and so do blocks with none released
const released=()=>D.units.filter(u=>u.status!=='soon');
let D;

// "Request a call" on WhatsApp, same contact as the 3D explorer
function waLink(msg){const w=((D.project.contact||{}).whatsapp||'').replace(/\D/g,'');return w?`https://wa.me/${w}?text=${encodeURIComponent(msg)}`:'';}

function render(){
  const P=D.project,U=D.units,liv=u=>u.inv&&u.inv.living!=null?+u.inv.living:u.m2+(u.upper||0),types=[...new Set(U.map(u=>u.type))].sort();
  $('#hero-title').textContent=P.name;$('#hero-place').textContent=P.place;
  $('#hero-sub').textContent=`${P.facts.residences} homes from ${types[0]} to ${types[types.length-1]} in ${P.facts.blocks} courtyard blocks`;
  $('#about').textContent=`${P.name} is ${P.facts.blocks} six-level courtyard blocks in ${P.place.split(' · ')[0]}, with ${P.facts.residences} homes from ${types[0]} to ${types[types.length-1]}. Each courtyard has pools, pergolas, play areas and gardens; every home has balconies and parking in the basement, and the commercial building sits on the boulevard.`;
  $('#facts').innerHTML=[[P.facts.residences,'Residences'],[P.facts.blocks,'Blocks'],[P.facts.levels,'Levels'],[types[0]+'–'+types[types.length-1],'Typologies'],
    [Math.round(Math.min(...U.map(liv)))+'–'+Math.round(Math.max(...U.map(liv)))+'<small>m²</small>','Living area'],['Level −1','Parking']].map(([b,t])=>`<div><b>${b}</b><span>${t}</span></div>`).join('');
  $('#feat').innerHTML=(D.amenities||[]).map(a=>`<li><a href="index.html#amenities">${icon(a.id)}<span><b>${a.name}</b><small>${a.fact}</small></span></a></li>`).join('');
  const wa=waLink(`Hello, I'm interested in ${P.name}. ${location.href.split('#')[0]}`),em=(P.contact||{}).email;
  $('#contact-cta').innerHTML=wa?`<a class="btn primary" href="${wa}" target="_blank" rel="noopener">Request a call</a>`:em?`<a class="btn primary" href="mailto:${em}">Request a call</a>`:'';
  if(wa)$('#top-call').href=wa,$('#top-call').target='_blank',$('#top-call').rel='noopener';
  renderBlocks();
  renderList();
}

// sales blocks A–H
function renderBlocks(){
  const ids=[...new Set(released().map(blockOf).filter(Boolean))].sort();
  $('#lot').innerHTML=[['','All blocks'],...ids.map(id=>[id,'Block '+id])].map(([id,n])=>`<button data-b="${id}" aria-pressed="${PJ.block===id}">${n}</button>`).join('');
}

function renderList(){
  const inT=released().filter(u=>!PJ.block||blockOf(u)===PJ.block),av=inT.filter(u=>(u.status||'available')==='available'),us=PJ.only?av:inT;
  const r=13,c=2*Math.PI*r;
  $('#count').innerHTML=`<svg viewBox="0 0 30 30" aria-hidden="true"><circle cx="15" cy="15" r="${r}" fill="none" stroke="rgba(255,255,255,.15)" stroke-width="3"/><circle cx="15" cy="15" r="${r}" fill="none" stroke="#9FD1DA" stroke-width="3" stroke-linecap="round" stroke-dasharray="${c*av.length/Math.max(1,inT.length)} ${c}"/></svg><span><b>${av.length}</b> of ${inT.length} available</span>`;
  const key=PJ.by==='type'?u=>u.type:u=>u.floor,groups=[...new Set(us.map(key))].sort((a,b)=>PJ.by==='type'?String(a).localeCompare(b):a-b);
  const row=u=>{const i=u.inv||{},s=ST[u.status]||ST.available,out=i.outdoor!=null?i.outdoor:(u.balc||0)+(u.terrace||0),pk=i.parking||u.parking||0;
    return `<tr data-id="${u.id}"><td class="id">${u.id}</td><td class="hm">${i.code||u.code||''}</td><td>${u.type}${u.duplex?' duplex':''}</td><td class="hm">${blockOf(u)}</td><td>${u.floor===0?'G':u.floor}</td><td class="n">${u.beds}</td><td class="n hm">${pk||'–'}</td><td class="n">${(+(i.living!=null?i.living:u.m2)).toFixed(1)} m²</td><td class="n hm">${out?(+out).toFixed(1)+' m²':'–'}</td><td class="n hm">${i.price?'€ '+fmtInt(i.price):'On request'}</td><td><span class="st" style="--c:${s.hex}">${s.label}</span></td><td class="go"><a href="${home(u)}" aria-label="Open home ${i.code||u.id}">${GO}</a></td></tr>`;};
  const ih=(cls,label,id)=>`<th class="${cls} ic" title="${label}"><span class="sr">${label}</span>${hico(id)}</th>`;
  const head=`<thead><tr><th>Unit</th><th class="hm">Code</th><th>Type</th><th class="hm">Block</th><th>Level</th>${ih('n','Bedrooms','bed')}${ih('n hm','Parking spaces','car')}${ih('n','Living area','area')}${ih('n hm','Outdoor area','tree')}<th class="n hm">Price</th><th>Status</th>${ih('go','Home','plan')}</tr></thead>`;
  $('#list').innerHTML=us.length?groups.map(g=>{const rows=us.filter(u=>key(u)===g).sort((a,b)=>a.tower.localeCompare(b.tower)||a.floor-b.floor||a.n-b.n);
    return `<h3 class="group">${PJ.by==='type'?g:D.floorNames[g]}<small>${rows.length} home${rows.length>1?'s':''}</small></h3><div class="tw"><table>${head}<tbody>${rows.map(row).join('')}</tbody></table></div>`;}).join(''):'<p class="empty">No units match.</p>';
}

// the whole row opens the home's own page; the arrow is the keyboard target
$('#list').addEventListener('click',e=>{const tr=e.target.closest('tr[data-id]');if(tr&&!e.target.closest('a'))location.href=home(D.units.find(u=>u.id===tr.dataset.id));});
$('#by').addEventListener('click',e=>{const b=e.target.closest('button[data-by]');if(!b)return;PJ.by=b.dataset.by;document.querySelectorAll('#by button').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));renderList();});
$('#lot').addEventListener('click',e=>{const b=e.target.closest('button[data-b]');if(!b)return;PJ.block=b.dataset.b;document.querySelectorAll('#lot button').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));renderList();});
$('#avail').addEventListener('change',e=>{PJ.only=e.target.checked;renderList();});
addEventListener('scroll',()=>$('#top').classList.toggle('solid',scrollY>40),{passive:true});

fetch('data.json').then(r=>r.json()).then(d=>{D=d;render();}).catch(()=>{$('#list').innerHTML='<p class="empty">Could not load the units. Open this page through the site server.</p>';});
</script>
</Base>
